# Copie para .env (que não é versionado). Tudo tem prefixo GEOF_.
GEOF_DATABASE_URL=postgresql://localhost/geo_fundiario
GEOF_AMBIENTE=desenvolvimento
GEOF_CORS_ORIGINS=http://localhost:3000
GEOF_HOSTS=localhost,127.0.0.1

# Em produção: GEOF_AMBIENTE=producao, GEOF_CORS_ORIGINS com o endereço exato do site,
# GEOF_HOSTS com o domínio da API e um usuário de banco que seja membro apenas de geof_api.
# Tokens: guarde aqui o SHA-256 de cada token, nunca o token.
#   python -c "import secrets,hashlib; t=secrets.token_urlsafe(32); print(t, hashlib.sha256(t.encode()).hexdigest())"
GEOF_TOKENS_LEITURA=
GEOF_TOKENS_ESCRITA=
GEOF_LIMITE_POR_MINUTO=120
GEOF_LIMITE_SENSIVEL_POR_MINUTO=20
GEOF_UPLOAD_MAX_MB=25
GEOF_ATRAS_DE_PROXY=false

# Consultas em linguagem natural (desligado enquanto vazio)
GEOF_ASSISTENTE_URL=
GEOF_ASSISTENTE_TOKEN=
